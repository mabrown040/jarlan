# Public site URL — used by SEO (canonical + sitemap + OG URL).
# Set to your production domain when deploying.
NEXT_PUBLIC_SITE_URL=https://calcifer.fire

# Sentry (error monitoring). Leave blank to disable — all Sentry code
# paths are no-ops without this.
#
# 1. Create a project at sentry.io (or self-host Sentry)
# 2. Paste the project's DSN below
# 3. For source-map upload on deploy, also set SENTRY_AUTH_TOKEN / ORG
#    / PROJECT in the deploy environment (not client-exposed).
NEXT_PUBLIC_SENTRY_DSN=
# Server-only DSN (defaults to NEXT_PUBLIC_SENTRY_DSN if unset).
SENTRY_DSN=
# Source-map upload — required for resolved stack traces. Leave blank
# for local dev; the build skips upload when absent (dryRun).
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=
# Set to "1" to enable Sentry in local development (off by default so
# HMR errors don't flood the quota).
SENTRY_DEBUG=

# Plausible analytics (privacy-first, no cookies). Leave blank to
# disable — the script tag doesn't render without a domain set.
#
# 1. Create a site at plausible.io (or self-host via plausible/analytics)
# 2. Set the domain below (whatever you registered at plausible)
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=
# Override the script URL if self-hosting Plausible.
NEXT_PUBLIC_PLAUSIBLE_SCRIPT_SRC=
