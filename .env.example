# Public site URL — used by SEO (canonical + sitemap + OG URL).
# Set to your production domain when deploying.
NEXT_PUBLIC_SITE_URL=https://calcifer.fire

# ── Supabase (cloud sync + auth) ──────────────────────────────────
# Leave blank to run in local-only mode (no accounts, no cloud sync).
# Create a project at https://supabase.com, then copy:
#   Settings → API → Project URL + anon/public key + service_role key
#
# NOTE: service_role bypasses Row-Level Security. Never expose it to
# the browser — it's server-only (webhook handler, admin tasks).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ── Stripe (Pro subscriptions) ────────────────────────────────────
# Leave blank to disable Pro checkout. Supabase auth still works.
# Create products at https://dashboard.stripe.com/products — one
# recurring product with two prices (monthly + yearly).
#
# The publishable key is client-safe; the secret key is server-only.
# The webhook secret is generated when you add a webhook endpoint
# pointing at /api/webhooks/stripe (Stripe Dashboard → Developers →
# Webhooks → Add endpoint).
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Price IDs (format: price_xxx) — find in Stripe Dashboard under
# each price row for your Pro product.
NEXT_PUBLIC_STRIPE_PRO_MONTHLY_PRICE_ID=
NEXT_PUBLIC_STRIPE_PRO_YEARLY_PRICE_ID=

# Analytics: Vercel Web Analytics + Speed Insights are active on any
# Vercel deployment with no env vars needed. Nothing to configure here.
